OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost
PORT=5000

# Auth: generate with  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me
JWT_EXPIRES_HOURS=24

# Database: defaults to a local SQLite file (resume_analyzer.db).
# On Render use a Postgres URL, e.g. postgresql://user:pass@host/dbname
# DATABASE_URL=

# Comma-separated frontend origins (default: *)
# CORS_ORIGINS=http://localhost:5173
